---
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/400-italic.css';
import '@fontsource/fraunces/500-italic.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import { SEO } from 'astro-seo';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Shrewsbury Christian Academy — a Christ-centered, STEM-forward private school for PreK-3 through 8th grade in New Freedom, Pennsylvania.",
  image = '/assets/img/logo-big.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href="/assets/img/logo.jpg" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: { title, type: 'website', image: new URL(image, Astro.site).toString() },
      }}
      twitter={{ card: 'summary_large_image' }}
    />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'School',
      name: 'Shrewsbury Christian Academy',
      url: 'https://scaonline.org',
      telephone: '+1-717-235-5763',
      email: 'office@scaonline.org',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '701 Windy Hill Road',
        addressLocality: 'New Freedom',
        addressRegion: 'PA',
        postalCode: '17349',
        addressCountry: 'US',
      },
    })}></script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <NavBar />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      const reveal = () => {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      };
      if (document.readyState !== 'loading') reveal();
      else document.addEventListener('DOMContentLoaded', reveal);
    </script>
  </body>
</html>
