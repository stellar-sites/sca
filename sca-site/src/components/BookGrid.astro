---
import { getCollection } from 'astro:content';
const books = (await getCollection('books')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-4 md:gap-5">
  {books.map((b) => (
    <figure class="group">
      <div class="aspect-[2/3] overflow-hidden rounded-md shadow-sm ring-1 ring-navy-100 bg-ivory-200">
        <img
          src={`/assets/books/${b.data.cover}`}
          alt={b.data.title}
          class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
          loading="lazy"
        />
      </div>
      <figcaption class="mt-2 text-xs text-navy-700/90 text-center line-clamp-2">{b.data.title}</figcaption>
    </figure>
  ))}
</div>
