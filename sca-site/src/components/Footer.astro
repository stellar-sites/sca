---
import { getEntry } from 'astro:content';
const { data: s } = await getEntry('site', 'default');
const year = new Date().getFullYear();
---

<footer class="relative mt-32 bg-navy-950 text-ivory overflow-hidden">
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 1px 1px, #FAF7F2 1px, transparent 0); background-size: 24px 24px;" aria-hidden="true"></div>

  <div class="container-wide relative py-20 md:py-24 grid gap-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <div class="flex items-center gap-3">
        <img src="/assets/img/logo.jpg" alt="" width="52" height="52" class="rounded-full ring-1 ring-brass" />
        <div class="leading-tight">
          <div class="font-display text-[1.35rem] tracking-[-0.01em]">Shrewsbury Christian Academy</div>
          <div class="font-mono text-eyebrow uppercase text-ivory/50 mt-1">Established 1977 · New Freedom, PA</div>
        </div>
      </div>
      <p class="mt-6 text-ivory/70 max-w-md leading-relaxed">
        A non-denominational Christian school serving PreK-3 through 8th grade in Southern York County, Pennsylvania.
      </p>
      <a href="/contact/#tour" class="btn-accent mt-8 inline-flex">Schedule a tour <span aria-hidden="true">→</span></a>
    </div>

    <div class="md:col-span-3 md:col-start-7">
      <div class="font-mono text-eyebrow uppercase text-brass">Visit</div>
      <address class="not-italic mt-5 text-ivory/85 leading-[1.8]">
        {s.address.street}<br />
        {s.address.city}, {s.address.state} {s.address.zip}<br />
        <a href={`tel:${s.phone.replace(/[^\d+]/g, '')}`} class="text-ivory hover:text-brass">{s.phone}</a><br />
        <a href={`mailto:${s.email}`} class="text-ivory hover:text-brass">{s.email}</a>
      </address>
    </div>

    <div class="md:col-span-3">
      <div class="font-mono text-eyebrow uppercase text-brass">Explore</div>
      <ul class="mt-5 space-y-3">
        <li><a href="/admissions/" class="text-ivory/85 hover:text-brass no-underline">Admissions</a></li>
        <li><a href="/tuition/" class="text-ivory/85 hover:text-brass no-underline">Tuition</a></li>
        <li><a href="/employment/" class="text-ivory/85 hover:text-brass no-underline">Employment</a></li>
        <li><a href="/support/" class="text-ivory/85 hover:text-brass no-underline">Give</a></li>
        <li><a href={s.externalLinks.sycamore} class="text-ivory/85 hover:text-brass no-underline" rel="noopener">Sycamore Portal ↗</a></li>
        <li><a href={s.externalLinks.efunds} class="text-ivory/85 hover:text-brass no-underline" rel="noopener">E-Funds ↗</a></li>
      </ul>
    </div>
  </div>
  <div class="relative border-t border-ivory/10">
    <div class="container-wide py-6 text-xs text-ivory/50 flex flex-col sm:flex-row sm:justify-between gap-2 font-mono uppercase tracking-[0.14em]">
      <span>© {year} Christian School of Southern York County · 501(c)(3) nonprofit</span>
      <span>scaonline.org</span>
    </div>
  </div>
</footer>
