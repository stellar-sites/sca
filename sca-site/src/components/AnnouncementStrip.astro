---
import { getCollection } from 'astro:content';

const now = new Date();
const announcements = (await getCollection('announcements'))
  .filter((a) => !a.data.expires || a.data.expires > now)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---

{announcements.length > 0 && (
  <section class="relative bg-ivory-200/70 border-y border-navy-100/60">
    <div class="container-wide py-10 md:py-12">
      <div class="grid md:grid-cols-12 gap-6 md:gap-10 items-start">
        <div class="md:col-span-3">
          <span class="eyebrow">What's new</span>
          <p class="mt-3 font-display text-[1.4rem] leading-[1.1] text-navy-700 tracking-[-0.015em]">Latest from SCA</p>
        </div>
        <div class="md:col-span-9 grid sm:grid-cols-3 gap-6 md:gap-8">
          {announcements.map(async (a) => {
            const { Content } = await a.render();
            const accent = a.data.variant === 'warning' ? 'text-brass-700' : a.data.variant === 'tip' ? 'text-sage-700' : 'text-navy-700';
            return (
              <article class="relative">
                <div class={`font-mono text-eyebrow uppercase ${accent}`}>
                  {a.data.variant === 'warning' ? 'Notice' : a.data.variant === 'tip' ? 'Tip' : 'Update'}
                </div>
                <h3 class="mt-3 font-display text-[1.15rem] leading-[1.25] text-navy-700 tracking-[-0.01em]">{a.data.title}</h3>
                <div class="mt-2 text-[0.9rem] text-ink/70 prose prose-sm max-w-none [&_p]:my-0">
                  <Content />
                </div>
                {a.data.link && (
                  <a href={a.data.link} class="inline-flex items-center gap-1.5 mt-3 text-[0.85rem] font-medium text-navy-700 hover:text-brass-700 no-underline">
                    {a.data.linkText ?? 'Learn more'} <span aria-hidden="true">→</span>
                  </a>
                )}
              </article>
            );
          })}
        </div>
      </div>
    </div>
  </section>
)}
