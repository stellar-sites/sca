---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Shrewsbury Christian Academy">
  <section class="section">
    <div class="container-prose text-center max-w-xl">
      <span class="eyebrow">404</span>
      <h1 class="mt-3 font-display text-4xl md:text-5xl text-navy-700">Page not found</h1>
      <p class="mt-4 text-ink/80">The page you're looking for doesn't exist or has moved.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">Back to home</a>
        <a href="/contact/" class="btn-secondary">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
