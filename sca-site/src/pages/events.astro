---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getEntry } from 'astro:content';
const { data: s } = await getEntry('site', 'default');
---

<BaseLayout title="Events — Shrewsbury Christian Academy">
  <PageHeader
    eyebrow="Events"
    title="What's happening at SCA."
    subtitle="Follow our school calendar and social media for upcoming events, performances, and community happenings."
  />

  <section class="section">
    <div class="container-prose grid lg:grid-cols-2 gap-8">
      <div class="rounded-2xl bg-white border border-navy-100 p-6 shadow-sm">
        <h2 class="font-display text-2xl text-navy-700">Academic Calendar</h2>
        <p class="mt-3 text-ink/80">Download the full {s.schoolYear} calendar PDF.</p>
        <a href="/assets/files/2024-25-sca-calendar.pdf" class="btn-primary mt-5 inline-flex">📄 Download calendar</a>
      </div>
      <div class="rounded-2xl bg-white border border-navy-100 p-6 shadow-sm">
        <h2 class="font-display text-2xl text-navy-700">Facebook Events</h2>
        <p class="mt-3 text-ink/80">See upcoming events, class highlights, and community moments on our Facebook page.</p>
        <a href={s.externalLinks.facebook} rel="noopener" class="btn-secondary mt-5 inline-flex">Open Facebook ↗</a>
      </div>
    </div>

    <div class="container-prose mt-12">
      <div class="rounded-2xl bg-sage/10 border border-sage/30 p-8 text-center">
        <h3 class="font-display text-2xl text-navy-700">Can't find what you're looking for?</h3>
        <p class="mt-3 text-ink/80">Call our office at <a href={`tel:${s.phone.replace(/[^\d+]/g, '')}`} class="text-navy-700 underline font-medium">{s.phone}</a> — we're happy to answer any questions about upcoming events.</p>
      </div>
    </div>
  </section>
</BaseLayout>
