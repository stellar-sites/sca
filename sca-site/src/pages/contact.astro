---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { getEntry } from 'astro:content';
const { data: s } = await getEntry('site', 'default');
---

<BaseLayout title="Contact — Shrewsbury Christian Academy">
  <PageHeader
    eyebrow="Contact"
    title="We'd love to hear from you."
    subtitle={`Office hours: ${s.officeHours.school}. Summer: ${s.officeHours.summer}.`}
  />

  <section class="section">
    <div class="container-prose grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5 space-y-4">
        <div class="rounded-2xl bg-white border border-navy-100 p-6">
          <div class="eyebrow">Visit</div>
          <address class="mt-3 not-italic text-ink leading-relaxed">
            <strong>Shrewsbury Christian Academy</strong><br />
            {s.address.street}<br />
            {s.address.city}, {s.address.state} {s.address.zip}
          </address>
        </div>
        <div class="rounded-2xl bg-white border border-navy-100 p-6">
          <div class="eyebrow">Phone & Email</div>
          <div class="mt-3 space-y-1 text-ink">
            <div>Phone: <a href={`tel:${s.phone.replace(/[^\d+]/g, '')}`} class="text-navy-700 hover:text-brass-700">{s.phone}</a></div>
            <div>Fax: {s.fax}</div>
            <div>Email: <a href={`mailto:${s.email}`} class="text-navy-700 hover:text-brass-700">{s.email}</a></div>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden border border-navy-100 shadow-sm">
          <iframe
            title="Map to Shrewsbury Christian Academy"
            src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d1533.8523126658358!2d-76.66371202579502!3d39.74628534654715!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0xeb24dba6d4e7b1b3!2sShrewsbury%20Christian%20Academy!5e0!3m2!1sen!2sus!4v1584024250903!5m2!1sen!2sus"
            width="100%" height="360"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen>
          </iframe>
        </div>
      </div>
      <div class="lg:col-span-7" id="tour">
        <div class="rounded-2xl bg-white border border-navy-100 p-8 shadow-sm">
          <span class="eyebrow">Send a message</span>
          <h2 class="mt-3 font-display text-3xl text-navy-700">Ask a question or schedule a tour</h2>
          <p class="mt-3 text-ink/80">Tell us a little about your family and what you're looking for. We'll be in touch shortly.</p>
          <div class="mt-8">
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
